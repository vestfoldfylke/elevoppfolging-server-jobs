{
  "name": "elevoppfolging-server-jobs",
  "version": "1.0.5",
  "description": "",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "safe-post-install": "npm rebuild mongodb-client-encryption",
    "watch": "tsc -w",
    "start": "npm run build && func start",
    "node:test": "MOCK_FINT=true MOCK_ENTRA=true MOCK_FINT_DATA_PATH=samma-driten.json  node --import tsx --test \"tests/**/*.test.ts\"",
    "test": "tsc --noEmit && biome check && npm run node:test",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "generate-fint-types": "node --env-file=.env node_modules/.bin/graphql-codegen --config codegen.ts",
    "generate-fint-types-v3": "node --env-file=.env node_modules/.bin/graphql-codegen --config codegen-v3.ts",
    "get-and-create-if-not-exists-encryption-keys": "node --env-file=.env --import tsx ./scripts/get-and-create-if-not-exists-encryption-keys.ts",
    "rewrap-encryption-keys": "node --env-file=.env --import tsx ./scripts/rewrap-encryption-keys.ts",
    "get-document-count-per-template": "node --env-file=.env --import tsx ./scripts/get-document-count-per-template.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.1",
    "@faker-js/faker": "^10.6.0",
    "@vestfoldfylke/loglady": "^2.1.0",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/node": "^26.6.6",
    "mongodb-client-encryption": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
